generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())

  name String

  email String @unique

  username String @unique

  password String

  role Role @default(USER)

  jenisUser JenisUser?

  mahasiswa Mahasiswa?

  dosen Dosen?

  staf Staf?

  reservations Reservation[]
  reports      Report[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  verified Boolean @default(false)
}

model Mahasiswa {
  id Int @id @default(autoincrement())

  nim String @unique

  userId Int @unique

  user User @relation(fields: [userId], references: [id])
}

model Dosen {
  id Int @id @default(autoincrement())

  nip String @unique

  userId Int @unique

  user User @relation(fields: [userId], references: [id])
}

model Staf {
  id Int @id @default(autoincrement())

  nip String @unique

  userId Int @unique

  user User @relation(fields: [userId], references: [id])
}

model Facility {
  id          Int            @id @default(autoincrement())
  code        String         @unique
  name        String
  building     String         @default("Gedung B")
  floor       String         @default("Lantai 1")
  type        FacilityType
  location    String
  capacity    Int
  description String?        @db.Text
  status      FacilityStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  reservations Reservation[]
  reports      Report[]

  @@index([type, location, capacity])
  @@index([status])
}

model Reservation {
  id         Int @id @default(autoincrement())
  userId     Int
  facilityId Int

  // Full date and time stored in UTC; operating hours use the campus timezone.
  startTime DateTime @map("start_time") @db.DateTime(0)
  endTime   DateTime @map("end_time") @db.DateTime(0)
  purpose   String   @db.Text

  status             ReservationStatus @default(PENDING)
  cancelledAt        DateTime?
  cancellationReason String?           @db.Text
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@index([facilityId, status, startTime, endTime])
  @@index([userId, createdAt])
}

model Report {
  id          Int          @id @default(autoincrement())
  userId      Int
  facilityId  Int
  category    String
  description String       @db.Text
  photoUrl    String?
  status      ReportStatus @default(PENDING)
  notes       String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([facilityId], map: "Report_facilityId_fkey")
  @@index([userId], map: "Report_userId_fkey")
}

enum FacilityType {
  CLASSROOM
  HALL
  LABORATORY
  EQUIPMENT
  FIELD
}

enum FacilityStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum Role {
  ADMIN

  PETUGAS

  USER
}

enum JenisUser {
  MAHASISWA

  DOSEN

  STAF
}

enum ReportStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}
