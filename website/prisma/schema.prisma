generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())

  name String

  email String @unique

  username String @unique

  password String

  role Role @default(USER)

  jenisUser JenisUser?

  mahasiswa Mahasiswa?

  dosen Dosen?

  staf Staf?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  verified     Boolean       @default(false)
  reservations Reservation[]
  reports      Report[]
}

model Mahasiswa {
  id Int @id @default(autoincrement())

  nim String @unique

  userId Int @unique

  user User @relation(fields: [userId], references: [id])
}

model Dosen {
  id Int @id @default(autoincrement())

  nip String @unique

  userId Int @unique

  user User @relation(fields: [userId], references: [id])
}

model Staf {
  id Int @id @default(autoincrement())

  nip String @unique

  userId Int @unique

  user User @relation(fields: [userId], references: [id])
}

enum Role {
  ADMIN

  PETUGAS

  USER
}

enum JenisUser {
  MAHASISWA

  DOSEN

  STAF
}

model Facility {
  id          Int            @id @default(autoincrement())
  name        String
  code        String         @unique
  building    String         @default("Gedung B")
  floor       String         @default("Lantai 1")
  location    String?
  capacity    Int?
  type        FacilityType   @default(RUANGAN)
  status      FacilityStatus @default(ACTIVE)
  description String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  reservations Reservation[]
  reports      Report[]
}

model Reservation {
  id          Int               @id @default(autoincrement())
  userId      Int
  facilityId  Int
  date        DateTime
  startTime   String
  endTime     String
  status      ReservationStatus @default(PENDING)
  purpose     String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  facility Facility @relation(fields: [facilityId], references: [id])
}

model Report {
  id          Int          @id @default(autoincrement())
  userId      Int
  facilityId  Int
  category    String
  description String       @db.Text
  photoUrl    String?
  status      ReportStatus @default(PENDING)
  notes       String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  facility Facility @relation(fields: [facilityId], references: [id])
}

enum FacilityType {
  RUANGAN
  LABORATORIUM
  AUDITORIUM
  AULA
}

enum FacilityStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ReportStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}
