generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int           @id @default(autoincrement())
  name        String
  email       String        @unique
  username    String        @unique
  password    String
  role        Role          @default(USER)
  jenisUser   JenisUser?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  verified    Boolean       @default(false)
  dosen       Dosen?
  mahasiswa   Mahasiswa?
  Report      Report[]
  Reservation Reservation[]
  staf        Staf?
  id Int @id @default(autoincrement())

  name String

  email String @unique

  username String @unique

  password String

  role Role @default(USER)

  jenisUser JenisUser?

  mahasiswa Mahasiswa?

  dosen Dosen?

  staf Staf?

  reservations Reservation[]
  reports      Report[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  verified     Boolean       @default(false)
  reservations Reservation[]
  reports      Report[]
}

model Mahasiswa {
  id     Int    @id @default(autoincrement())
  nim    String @unique
  userId Int    @unique
  user   User   @relation(fields: [userId], references: [id])
}

model Dosen {
  id     Int    @id @default(autoincrement())
  nip    String @unique
  userId Int    @unique
  user   User   @relation(fields: [userId], references: [id])
}

model Staf {
  id     Int    @id @default(autoincrement())
  nip    String @unique
  userId Int    @unique
  user   User   @relation(fields: [userId], references: [id])
}

model Facility {
  id          Int             @id @default(autoincrement())
  name        String
  code        String          @unique
  building    String          @default("Gedung B")
  floor       String          @default("Lantai 1")
  location    String
  capacity    Int
  type        Facility_type
  status      Facility_status @default(ACTIVE)
  description String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime
  Report      Report[]
  Reservation Reservation[]

  @@index([status])
  @@index([type, location, capacity])
}

model Facility_backup_20260924 {
  id          Int                             @id @default(autoincrement())
  name        String
  code        String                          @unique(map: "Facility_code_key")
  building    String                          @default("Gedung B")
  floor       String                          @default("Lantai 1")
  location    String?
  capacity    Int?
  type        Facility_backup_20260924_type   @default(RUANGAN)
  status      Facility_backup_20260924_status @default(ACTIVE)
  description String?                         @db.Text
  createdAt   DateTime                        @default(now())
  updatedAt   DateTime
}

model Report {
  id          Int           @id @default(autoincrement())
  userId      Int
  facilityId  Int
  category    String
  description String        @db.Text
  photoUrl    String?
  status      Report_status @default(PENDING)
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  Facility    Facility      @relation(fields: [facilityId], references: [id])
  User        User          @relation(fields: [userId], references: [id])

  @@index([facilityId], map: "Report_facilityId_fkey")
  @@index([userId], map: "Report_userId_fkey")
}

model Reservation {
  id                 Int                @id @default(autoincrement())
  userId             Int
  facilityId         Int
  start_time         DateTime           @db.DateTime(0)
  end_time           DateTime           @db.DateTime(0)
  status             Reservation_status @default(PENDING)
  purpose            String             @db.Text
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  cancelledAt        DateTime?
  cancellationReason String?            @db.Text
  Facility           Facility           @relation(fields: [facilityId], references: [id])
  User               User               @relation(fields: [userId], references: [id])

  @@index([facilityId, status, start_time, end_time])
  @@index([userId, createdAt])
}

model Reservation_backup_20260924 {
  id         Int                                @id @default(autoincrement())
  userId     Int
  facilityId Int
  date       DateTime
  startTime  String
  endTime    String
  status     Reservation_backup_20260924_status @default(PENDING)
  purpose    String?                            @db.Text
  createdAt  DateTime                           @default(now())
  updatedAt  DateTime

  @@index([facilityId], map: "Reservation_facilityId_fkey")
  @@index([userId], map: "Reservation_userId_fkey")
}

model Facility {
  id          Int            @id @default(autoincrement())
  code        String         @unique
  name        String
  building     String         @default("Gedung B")
  floor       String         @default("Lantai 1")
  type        FacilityType
  location    String
  capacity    Int
  description String?        @db.Text
  status      FacilityStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  reservations Reservation[]
  reports      Report[]

  @@index([type, location, capacity])
  @@index([status])
}

model Reservation {
  id         Int @id @default(autoincrement())
  userId     Int
  facilityId Int

  // Full date and time stored in UTC; operating hours use the campus timezone.
  startTime DateTime @map("start_time") @db.DateTime(0)
  endTime   DateTime @map("end_time") @db.DateTime(0)
  purpose   String   @db.Text

  status             ReservationStatus @default(PENDING)
  cancelledAt        DateTime?
  cancellationReason String?           @db.Text
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@index([facilityId, status, startTime, endTime])
  @@index([userId, createdAt])
}

model Report {
  id          Int          @id @default(autoincrement())
  userId      Int
  facilityId  Int
  category    String
  description String       @db.Text
  photoUrl    String?
  status      ReportStatus @default(PENDING)
  notes       String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([facilityId], map: "Report_facilityId_fkey")
  @@index([userId], map: "Report_userId_fkey")
}

